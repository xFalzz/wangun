# ================================
# DATABASE
# ================================
# PostgreSQL connection string (lokal: pakai docker-compose.yml di root)
DATABASE_URL=postgresql://wangun:wangun_dev@localhost:5432/wangun_db

# ================================
# AUTH (NextAuth v5 / Auth.js)
# ================================
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# URL aplikasi (lokal: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — buat di console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================
# AI PROVIDERS
# ================================
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# Groq (opsional, untuk fallback) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# OpenRouter (opsional, untuk fallback terakhir) — https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key

# ================================
# ADMIN
# ================================
# Email admin untuk akses halaman /admin (Build #13)
ADMIN_EMAIL=your-email@example.com
